# AI Learn OS local configuration.
# Copy to .env only for local use. Never commit real API keys.

AI_LEARN_DATABASE_URL=sqlite:///data/ai_learn_os.sqlite3
AI_LEARN_API_HOST=127.0.0.1
AI_LEARN_API_PORT=8765

# OpenAI-compatible provider. Tests use FakeModelGateway and do not need keys.
# DeepSeek-compatible defaults are provided for quick alpha testing.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
AI_LEARN_FAST_MODEL=deepseek-v4-flash
AI_LEARN_MEDIUM_MODEL=deepseek-v4-flash
AI_LEARN_STRONG_MODEL=deepseek-v4-pro

# Legacy local UI defaults kept for compatibility with the old CLI helper.
AI_LEARNING_OS_TIMEZONE=Asia/Shanghai
AI_LEARNING_OS_CONTEXT_BUDGET=medium
AI_LEARNING_OS_UI_HOST=127.0.0.1
AI_LEARNING_OS_UI_PORT=8765
