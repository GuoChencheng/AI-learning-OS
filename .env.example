# ai-learning-os is prompt-only by default.
# Copy to .env only for local use. Never commit real API keys.

# Optional OpenAI-compatible provider examples:
# OPENROUTER_API_KEY=replace-with-local-secret
# LOCAL_OPENAI_API_KEY=replace-with-local-secret-if-your-local-server-requires-one

AI_LEARNING_OS_PROMPT_ONLY=true
AI_LEARNING_OS_TIMEZONE=Asia/Shanghai
AI_LEARNING_OS_CONTEXT_BUDGET=medium
AI_LEARNING_OS_UI_HOST=127.0.0.1
AI_LEARNING_OS_UI_PORT=8765
